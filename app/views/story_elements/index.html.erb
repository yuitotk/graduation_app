<%= render "shared/breadcrumbs", items: @breadcrumbs %>

<%
  story_event_for_back_link =
    if params[:story_event_id].present?
      @story.story_events.find_by(id: params[:story_event_id])
    end

  story_event_idea_for_back_link =
    if story_event_for_back_link.present? && params[:story_event_idea_id].present?
      story_event_for_back_link.story_event_ideas.find_by(id: params[:story_event_idea_id])
    end
%>

<% if params[:from] == "story_event_idea" && story_event_for_back_link.present? && story_event_idea_for_back_link.present? %>
  <%= link_to "詳細メモ詳細へ戻る",
              story_story_event_story_event_idea_path(@story, story_event_for_back_link, story_event_idea_for_back_link),
              style: "color: #9ecbff; font-weight: bold; text-decoration: underline;" %>
<% elsif params[:from] == "story_event" && story_event_for_back_link.present? %>
  <%= link_to "イベント詳細へ戻る",
              story_story_event_path(@story, story_event_for_back_link),
              style: "color: #9ecbff; font-weight: bold; text-decoration: underline;" %>
<% else %>
  <%= link_to "ストーリー詳細へ戻る",
              story_path(@story),
              style: "color: #9ecbff; font-weight: bold; text-decoration: underline;" %>
<% end %>

<style>
  /*
    このページ冒頭の紹介カード。ストーリー詳細ページなどの紹介カードと
    同じ考え方で、見出し＋説明文を背景色と枠線のついた「箱」で囲んでいる。
  */
  .story-section-card {
    /*
      枠・角ブラケット・発光に使う色。ここでは青をデフォルトにしているが、
      個別のカード側で style="--card-accent-rgb: 168, 85, 247;" のように
      上書きすると、そのカードだけ色を変えられる（下の紫カードの例）。
    */
    --card-accent-rgb: 56, 189, 248;

    background-color: rgba(0, 0, 0, 0.55);
    border: 2px solid rgba(var(--card-accent-rgb), 0.5);
    border-radius: 6px;
    padding: 20px;
    margin: 20px 0;

    /*
      対象をロックオンしているような「四隅の角ブラケット」。
      background-image に、線1本ぶんの単色グラデーションを8枚重ね、
      それぞれを background-position で四隅（横線・縦線のペア）に配置している。
      内側に余白を空けず、カードの実際の角ぴったりに合わせている。
    */
    background-image:
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1));
    background-repeat: no-repeat;
    background-size:
      32px 3px, 3px 32px,
      32px 3px, 3px 32px,
      32px 3px, 3px 32px,
      32px 3px, 3px 32px;
    background-position:
      left 0 top 0, left 0 top 0,
      right 0 top 0, right 0 top 0,
      left 0 bottom 0, left 0 bottom 0,
      right 0 bottom 0, right 0 bottom 0;
    background-origin: border-box;

    /*
      ロックオン中のようなうっすら発光する雰囲気を、カード全体に足す。
      1つ目（inset無し）が外側への光、2つ目（inset）が内側への光。
    */
    box-shadow:
      0 0 24px rgba(var(--card-accent-rgb), 0.55),
      inset 0 0 80px rgba(var(--card-accent-rgb), 0.65);
  }
</style>

<div class="story-section-card" style="--card-accent-rgb: 192, 132, 252;">
  <h1 style="color: #c4b5fd; margin-top: 0;">要素一覧</h1>

  <p style="margin: 8px 0 0 0; font-size: 17px;">
    このストーリーで出てくる要素一覧です。<br>
    気楽に要素追加から作成していきましょう。
  </p>
</div>

<%= link_to "要素追加",
            new_story_story_element_path(@story, breadcrumb_params),
            style: "display: inline-block; margin-top: 8px; margin-bottom: 16px; padding: 10px 16px; background-color: #2563eb; color: #ffffff; font-weight: bold; text-decoration: none; border-radius: 8px;" %>

<% grouped_elements = @story_elements.group_by(&:kind) %>

<% [
  ["character", "キャラクター"],
  ["item", "アイテム"],
  ["setting", "設定"],
  ["place", "場所"],
  ["organization", "団体・グループ"]
].each do |kind, title| %>
  <% next if grouped_elements[kind].blank? %>

  <h2 style="color: #c4b5fd;"><%= title %></h2>

  <ul>
    <% grouped_elements[kind].each do |e| %>
      <li>
        <%= link_to "#{e.marker.present? ? "#{e.marker}　" : ""}#{e.name}",
                    story_story_element_path(@story, e, breadcrumb_params),
                    style: "color: #9ecbff; font-weight: bold; text-decoration: underline;" %>
      </li>
    <% end %>
  </ul>
<% end %>
