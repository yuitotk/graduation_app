<%= render "shared/breadcrumbs", items: @breadcrumbs %>

<style>
  /*
    このページ全体を囲む紹介カード。ストーリー詳細ページなどの紹介カードと
    同じ考え方で、背景色と枠線のついた「箱」で内容全体を囲んでいる。
  */
  .story-section-card {
    /* 枠・角ブラケット・発光に使う色。ここでは紫を指定している。 */
    --card-accent-rgb: 192, 132, 252;

    background-color: rgba(0, 0, 0, 0.55);
    border: 2px solid rgba(var(--card-accent-rgb), 0.5);
    border-radius: 6px;
    padding: 20px;
    margin: 20px 0;

    /*
      対象をロックオンしているような「四隅の角ブラケット」。
      background-image に、線1本ぶんの単色グラデーションを8枚重ね、
      それぞれを background-position で四隅（横線・縦線のペア）に配置している。
      内側に余白を空けず、カードの実際の角ぴったりに合わせている。
    */
    background-image:
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1));
    background-repeat: no-repeat;
    background-size:
      32px 3px, 3px 32px,
      32px 3px, 3px 32px,
      32px 3px, 3px 32px,
      32px 3px, 3px 32px;
    background-position:
      left 0 top 0, left 0 top 0,
      right 0 top 0, right 0 top 0,
      left 0 bottom 0, left 0 bottom 0,
      right 0 bottom 0, right 0 bottom 0;
    background-origin: border-box;

    /*
      ロックオン中のようなうっすら発光する雰囲気を、カード全体に足す。
      1つ目（inset無し）が外側への光、2つ目（inset）が内側への光。
    */
    box-shadow:
      0 0 24px rgba(var(--card-accent-rgb), 0.55),
      inset 0 0 80px rgba(var(--card-accent-rgb), 0.65);
  }
</style>

<%= link_to "戻る",
            story_story_element_path(@story, @story_element, breadcrumb_params),
            style: "color: #9ecbff; font-weight: bold; text-decoration: underline;" %>

<div class="story-section-card">
  <h1 style="color: #c4b5fd; margin-top: 0;">要素編集</h1>

  <%= render "form" %>
</div>

<p style="color: #f87171; font-weight: bold; margin-top: 24px; margin-bottom: 8px;">
  削除すると、この要素内のアイデアは消えます。<br>
  また、このストーリー内でこの要素を選択しているアイデア、イベントなどからも外れます。
</p>

<p>
  <%= link_to "削除",
        story_story_element_path(@story, @story_element, breadcrumb_params),
        data: { turbo_method: :delete, turbo_confirm: "本当に削除しますか？要素内アイデアと要素選択したアイデアなどからも外れます" },
        style: "display: inline-block; background: #dc2626; color: #ffffff; border: none; border-radius: 8px; padding: 12px 24px; font-weight: bold; text-decoration: none; cursor: pointer;" %>
</p>
