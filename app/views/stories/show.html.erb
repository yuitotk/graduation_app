<%= render "shared/breadcrumbs", items: @breadcrumbs %>

<style>
  /*
    ストーリー詳細ページ専用のカード枠。
    これまで <hr> の線1本だけで区切っていたセクションを、
    背景色と枠線のついた「箱」で囲むことで、区切りをはっきりさせる。
  */
  .story-section-card {
    /*
      枠・角ブラケット・発光に使う色。ここでは青をデフォルトにしているが、
      個別のカード側で style="--card-accent-rgb: 168, 85, 247;" のように
      上書きすると、そのカードだけ色を変えられる（下の紫カードの例）。
    */
    --card-accent-rgb: 56, 189, 248;

    background-color: rgba(0, 0, 0, 0.55);
    border: 2px solid rgba(var(--card-accent-rgb), 0.5);
    border-radius: 6px;
    padding: 20px;
    margin: 20px 0;

    /*
      対象をロックオンしているような「四隅の角ブラケット」。
      背が高いカード（本文カード・右のタブエリアなど）だと、上下の角ブラケット
      だけでは辺の途中に線が無く途切れて見えるため、辺をつなぐ細く薄い線として
      上の border を敷き、その上に太く明るい角ブラケットを重ねている。
      background-image に、線1本ぶんの単色グラデーションを8枚重ね、
      それぞれを background-position で四隅（横線・縦線のペア）に配置している。
      内側に余白を空けず、カードの実際の角ぴったりに合わせている。
    */
    background-image:
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1));
    background-repeat: no-repeat;
    background-size:
      32px 3px, 3px 32px,
      32px 3px, 3px 32px,
      32px 3px, 3px 32px,
      32px 3px, 3px 32px;
    background-position:
      left 0 top 0, left 0 top 0,
      right 0 top 0, right 0 top 0,
      left 0 bottom 0, left 0 bottom 0,
      right 0 bottom 0, right 0 bottom 0;
    background-origin: border-box;

    /*
      ロックオン中のようなうっすら発光する雰囲気を、カード全体に足す。
      1つ目（inset無し）が外側への光、2つ目（inset）が内側への光。
    */
    box-shadow:
      0 0 24px rgba(var(--card-accent-rgb), 0.55),
      inset 0 0 80px rgba(var(--card-accent-rgb), 0.65);
  }

  /*
    左＝ストーリー本文、右＝イベント・アイデアのタブ欄を横並びにする行。

    この行自体を画面に固定し（sticky）、画面の高さを上限にしている。
    左右それぞれの中はこの行の中だけで独立してスクロールするので、
    ページ全体をどれだけスクロールしても、本文の表示位置は変わらない。

    height ではなく max-height にしているのは、中身が少ないストーリー
    （イベント・アイデアがまだ無いなど）のときに、画面の高さぶん
    無理やり引き伸ばされて大きな空白ができてしまわないようにするため。
    中身が画面の高さを超えたときだけ、そこで頭打ちになり内部スクロールが働く。

    （画面が狭いとき（スマホなど）は、下の @media で通常の縦積み・
    通常スクロールに戻す）
  */
  .story-two-col {
    display: flex;
    gap: 120px;
    margin: 20px 0;
    position: sticky;
    top: 20px;
    max-height: calc(100vh - 40px);
  }

  /*
    左右それぞれの列の外枠。高さは常にこの行いっぱい（100%）。
    列自体はスクロールさせず、中の「スクロールする範囲」だけを決める土台にする。
  */
  .story-two-col__column {
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex: 1 1 320px;
    min-width: 0;
    min-height: 0;
  }

  .story-two-col__column > .story-section-card {
    margin: 0;
  }

  /*
    幅は、左（ストーリー本文）を右（イベント・アイデアのタブ欄）より
    広め（6:3）にしている。間の隙間（gap）をページのスクロール操作用に
    広く取りたいので、左を少し狭めにしている。
  */
  .story-two-col__column--wide {
    flex-grow: 6;
  }

  .story-two-col__column:not(.story-two-col__column--wide) {
    flex-grow: 3;
  }

  /*
    左（本文）も、中身がこの高さより長くなったら、この欄の中だけで
    スクロールする（.story-two-col__column--wide は、横方向の幅比率
    (flex-grow: 8)を上書きしないよう、flex-shrink/flex-basis だけを
    個別に指定している）。

    overscroll-behavior は指定しない（初期値 auto のまま）。
    本文欄のスクロールが端（上端・下端）まで来たら、その先はページ全体の
    スクロールにそのまま引き継がれてよい、という意図。
  */
  .story-two-col__column--wide {
    flex-shrink: 1;
    flex-basis: 320px;
    min-height: 0;
    overflow-y: auto;
  }

  /*
    右（イベント・アイデア）は、タブ欄を除いた下側だけがスクロール範囲
    （.story-tab-panels）で、タブ欄自体は常に上に留まる。
    overflow-y: auto でこの範囲の中だけでスクロールし、
    overscroll-behavior: contain で、スクロールが端まで来ても
    その先（ページ全体）が引きずられて動かないようにする。
  */

  .story-tab-panels {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* スマホなど画面が狭いときは、固定・独立スクロールをやめて通常表示に戻す */
  @media (max-width: 767px) {
    .story-two-col {
      flex-wrap: wrap;
      position: static;
      max-height: none;
    }

    .story-tab-panels {
      overflow-y: visible;
      overscroll-behavior: auto;
    }
  }

  /*
    右カラムの「イベント／新規アイデア／移動したアイデア」切り替えタブ。
    3つのアイコンボタンを並べ、押した欄だけを表示する
    （表示の切り替えは app/javascript/controllers/panel_tabs_controller.js）。
    タブ欄自体はスクロールせず、常に右カラムの上に留まる。
  */
  .story-tab-bar {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .story-tab-button {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 10px 8px;
    background: rgba(0, 0, 0, 0.55);
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 12px;
    color: #cbd5e1;
    font-size: 12px;
    cursor: pointer;
  }

  .story-tab-button svg {
    width: 22px;
    height: 22px;
  }

  .story-tab-button.is-active {
    background: rgba(56, 189, 248, 0.35);
    border-color: #7dd3fc;
    color: #f5f5f5;
    font-weight: bold;
  }
</style>

<p><%= link_to "ストーリー一覧へ", stories_path, style: "color: #9ecbff; font-weight: bold; text-decoration: underline;" %></p>

<div class="story-section-card" style="--card-accent-rgb: 192, 132, 252;">
  <div style="display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; margin-bottom: 8px;">
    <h1 style="color: #c4b5fd; margin: 0;">ストーリー詳細ページ</h1>
    <%= render "shared/page_position_indicator", current: :story %>
  </div>

  <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #cbd5e1;">
    アイデアをこの作品に移動して素材を増やし、イベントを追加すると物語の流れを時系列で整理できます。
  </p>
</div>

<div class="story-two-col">
  <div class="story-two-col__column story-two-col__column--wide">
    <div class="story-section-card">
      <h1 style="color: #7dd3fc; margin-top: 0;"><%= @story.title %></h1>

      <% if @story.story_image&.image? %>
        <div style="margin-top: 16px;">
          <%= image_tag @story.story_image.image.url, style: "max-width: 320px; height: auto; border-radius: 16px;" %>
        </div>
      <% end %>

      <h2 style="color: #7dd3fc;">説明</h2>
      <% if @story.description.present? %>
        <div>
          <%= simple_format(@story.description) %>
        </div>
      <% else %>
        <p>なし</p>
      <% end %>

      <p style="margin-bottom: 0;">
        <%= link_to "ストーリー編集", edit_story_path(@story), style: "color: #9ecbff; font-weight: bold; text-decoration: underline;" %>
        <span style="display: inline-block; margin-left: 24px;">
          作成日: <%= l @story.created_at.in_time_zone("Tokyo"), format: :short %>
        </span>
        <span style="display: inline-block; margin-left: 24px;">
          更新日（文字修正のみ）: <%= l (@story.text_updated_at || @story.created_at).in_time_zone("Tokyo"), format: :short %>
        </span>
      </p>

      <%# 本文の表示範囲に余白を持たせるための空間 %>
      <div style="height: 60px;"></div>
    </div>
  </div>

  <div class="story-two-col__column" data-controller="panel-tabs">
    <div class="story-tab-bar">
      <button type="button" class="story-tab-button" data-panel-tabs-target="tab" data-action="panel-tabs#select" data-panel-tabs-index-param="0" aria-label="イベント">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>
        <span>イベント</span>
      </button>
      <button type="button" class="story-tab-button" data-panel-tabs-target="tab" data-action="panel-tabs#select" data-panel-tabs-index-param="1" aria-label="新規アイデア">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18h6"/><path d="M10 21h4"/><path d="M12 3a6 6 0 0 0-3.6 10.8c.6.45 1.1 1.2 1.1 2.2h5c0-1 .5-1.75 1.1-2.2A6 6 0 0 0 12 3z"/></svg>
        <span>新規アイデア</span>
      </button>
      <button type="button" class="story-tab-button" data-panel-tabs-target="tab" data-action="panel-tabs#select" data-panel-tabs-index-param="2" aria-label="移動したアイデア">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h9"/><path d="M11 12h9M17 9l3 3-3 3"/></svg>
        <span>移動アイデア</span>
      </button>
    </div>

    <div class="story-tab-panels">
    <div data-panel-tabs-target="panel">
      <div class="story-section-card" data-controller="scroll-into-view">
        <h2 data-scroll-into-view-target="anchor" style="color: #7dd3fc; margin-top: 0;">イベント（時系列）</h2>

        <h4>このイベント欄は、整合性チェックの対象です。上から時系列の早い順として表示します。</h4>

        <p>
          <%= link_to "イベント追加", new_story_story_event_path(@story),
                      style: "display: inline-block; padding: 10px 16px; border: 2px solid #2563eb; border-radius: 12px; background: #2563eb; color: #ffffff; text-decoration: none; font-weight: bold;" %>
        </p>

        <%= render "story_events_list", story: @story, story_events: @story_events %>
      </div>
    </div>

    <div data-panel-tabs-target="panel" hidden>
      <div class="story-section-card" data-controller="scroll-into-view">
        <h3 data-scroll-into-view-target="anchor" style="color: #7dd3fc; margin-top: 0;">新規アイデア</h3>

        <p style="margin: 8px 0 20px 20px; font-size: 17px; line-height: 1.8;">
          作成した要素は、アイデア作成時に登場要素として選択できます。<br>
          アイデアと要素を結びつけておくと、検索で見つけやすくなり、あとから設定や登場場面を整理しやすくなります。
        </p>

        <p style="margin: 0 0 16px 0;">
          <%= link_to "アイデアを作成する", new_idea_path(return_to: request.fullpath, placeable_type: "Story", placeable_id: @story.id),
                      style: "display: inline-block; padding: 10px 16px; border: 2px solid #5f8f6b; border-radius: 12px; background: #5f8f6b; color: #ffffff; text-decoration: none; font-weight: bold; margin-right: 12px;" %>
          <%= link_to "AIで作成する", random_words_pick_path(return_to: request.fullpath, placeable_type: "Story", placeable_id: @story.id),
                      style: "display: inline-block; padding: 10px 16px; border: 2px solid #5f6ee6; border-radius: 12px; background: #5f6ee6; color: #ffffff; text-decoration: none; font-weight: bold;" %>
        </p>

        <%= render "shared/placed_ideas",
                   ideas: @created_here_ideas,
                   frame_id: "created_here_ideas_list",
                   page_param: :created_here_page,
                   link_params: {},
                   link_style: "color: #7dd3fc; font-weight: bold; text-decoration: underline;" %>
      </div>
    </div>

    <div data-panel-tabs-target="panel" hidden>
      <div class="story-section-card" data-controller="scroll-into-view">
        <h3 data-scroll-into-view-target="anchor" style="color: #7dd3fc; margin-top: 0;">ここに移動したアイデア</h3>

        <%= render "shared/placed_ideas",
                   ideas: @moved_ideas,
                   frame_id: "moved_ideas_list",
                   page_param: :moved_page,
                   link_params: {},
                   link_style: "color: #7dd3fc; font-weight: bold; text-decoration: underline;" %>
      </div>
    </div>
    </div>
  </div>
</div>
