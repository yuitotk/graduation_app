<%= render "shared/breadcrumbs", items: @breadcrumbs %>

<%
  breadcrumb_params = {
    from: params[:from],
    story_event_id: params[:story_event_id],
    story_event_idea_id: params[:story_event_idea_id]
  }.compact.symbolize_keys
%>

<p>
  <% if params[:from] == "story_event_idea" && params[:story_event_id].present? && params[:story_event_idea_id].present? %>
    <%= link_to "詳細メモ詳細へ戻る",
                story_story_event_story_event_idea_path(@story, params[:story_event_id], params[:story_event_idea_id]),
                style: "color: #9ecbff; font-weight: bold; text-decoration: underline;" %>
  <% elsif params[:from] == "story_event" && params[:story_event_id].present? %>
    <%= link_to "イベント詳細へ戻る",
                story_story_event_path(@story, params[:story_event_id]),
                style: "color: #9ecbff; font-weight: bold; text-decoration: underline;" %>
  <% else %>
    <%= link_to "ストーリー詳細へ戻る",
                story_path(@story),
                style: "color: #9ecbff; font-weight: bold; text-decoration: underline;" %>
  <% end %>
</p>

<h1 style="color: #c4b5fd;">整合性チェック</h1>
<h4>イベントと詳細メモのみ検索対象で時系列表示されます。アイデアは含まれません。</h4>
<h4>詳細メモで要素を選択していても、イベント自体にその要素が設定されていない場合は表示されません。</h4>
<h4>複数選んだ場合は、選んだ要素が全員そろって登場する場面だけを表示します。</h4>

<% kind_label_for = lambda do |element|
     case element.kind
     when "character"
       "キャラ"
     when "item"
       "アイテム"
     when "setting"
       "設定"
     when "place"
       "場所"
     when "organization"
       "団体"
     else
       element.kind
     end
   end %>

<% element_label_for = lambda do |element|
     "[#{kind_label_for.call(element)}]#{element.try(:marker)}　#{element.name}"
   end %>

<%= form_with url: consistency_story_path(@story), method: :get, local: true,
              data: { controller: "element-selector", action: "change->element-selector#refresh" } do %>
  <%= hidden_field_tag :from, params[:from] if params[:from].present? %>
  <%= hidden_field_tag :story_event_id, params[:story_event_id] if params[:story_event_id].present? %>
  <%= hidden_field_tag :story_event_idea_id, params[:story_event_idea_id] if params[:story_event_idea_id].present? %>

  <div style="max-width: 420px; width: 100%;">
    <div style="color: #c4b5fd; font-size: 24px; font-weight: bold;">要素を選ぶ（複数選択可）</div>

    <% if @elements.blank? %>
      <p style="color: #cccccc;">要素がまだありません（先に要素を作成してください）</p>
    <% else %>
      <% grouped_elements = @elements.group_by(&:kind) %>

      <%# チェックした瞬間、押す前でもここに選んだ要素がタグで表示される %>
      <div style="margin-top: 12px; margin-bottom: 12px; border: 1px solid #555555; border-radius: 8px; padding: 16px; background: #1e1e1e; color: #ffffff;">
        <div style="font-size: 20px; font-weight: bold; margin-bottom: 4px; color: #ddd6fe;">
          選択中の要素
        </div>
        <p style="margin: 0 0 12px 0; font-size: 14px; color: #cccccc;">
          ×を押すと、その要素の選択を解除できます。
        </p>

        <p data-element-selector-target="emptyMessage" style="margin: 0; color: #cccccc;">
          まだ選択されていません
        </p>

        <div data-element-selector-target="summary" data-kind="character" hidden style="margin-bottom: 16px; color: #ffffff;"></div>
        <div data-element-selector-target="summary" data-kind="item" hidden style="margin-bottom: 16px; color: #ffffff;"></div>
        <div data-element-selector-target="summary" data-kind="setting" hidden style="margin-bottom: 16px; color: #ffffff;"></div>
        <div data-element-selector-target="summary" data-kind="place" hidden style="margin-bottom: 16px; color: #ffffff;"></div>
        <div data-element-selector-target="summary" data-kind="organization" hidden style="color: #ffffff;"></div>
      </div>

      <div style="margin-top: 12px; border: 1px solid #555555; border-radius: 8px; padding: 16px; background: #1e1e1e; color: #ffffff;">
        <%# 分類ごとに開閉できるようにする。要素が増えても一覧が縦に長くなりすぎないようにするため %>
        <% [
          ["character", "キャラクター"],
          ["item", "アイテム"],
          ["setting", "設定"],
          ["place", "場所"],
          ["organization", "団体・グループ"]
        ].each do |kind, kind_group_label| %>
          <% elements_of_kind = grouped_elements[kind] || [] %>
          <% next if elements_of_kind.blank? %>

          <% any_selected_in_kind = elements_of_kind.any? { |el| @selected_elements.any? { |s| s.id == el.id } } %>

          <%# すでにその分類から選択済みの要素がある場合は、開いた状態で表示する %>
          <details style="margin-bottom: 12px;" <%= "open" if any_selected_in_kind %>>
            <summary style="cursor: pointer; background: #2a2a2a; border: 1px solid #555555; border-radius: 6px; padding: 10px 12px; font-weight: bold; color: #f5f5f5;">
              <%= kind_group_label %>（<%= elements_of_kind.size %>）
            </summary>

            <div style="padding: 12px 8px 0 8px;">
              <% elements_of_kind.each do |element| %>
                <div style="margin-bottom: 8px; display: flex; align-items: center; gap: 8px; color: #ffffff;">
                  <% checkbox_id = "consistency_story_element_ids_#{element.id}" %>

                  <%= check_box_tag "consistency_story_element_ids[]",
                        element.id,
                        @selected_elements.any? { |selected| selected.id == element.id },
                        id: checkbox_id,
                        data: {
                          "element-selector-target": "checkbox",
                          kind: element.kind,
                          label: truncate(element_label_for.call(element), length: 40)
                        } %>

                  <label for="<%= checkbox_id %>" style="cursor: pointer; margin-bottom: 0; color: #ffffff;">
                    <%= truncate(element_label_for.call(element), length: 40) %>
                  </label>
                </div>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
    <% end %>

    <div style="margin-top: 8px;">
      <%= submit_tag "表示",
            style: "background: #2563eb; color: #ffffff; border: none; border-radius: 8px; padding: 10px 20px; font-weight: bold; cursor: pointer;" %>
    </div>
  </div>
<% end %>

<hr style="border: none; border-top: 1px solid #444444; margin: 20px 0;">

<% if @selected_elements.present? %>
  <div style="font-size: 20px; font-weight: bold; margin-bottom: 8px; color: #c4b5fd;">選択した要素の詳細</div>

  <% @selected_elements.each do |selected_element| %>
    <% element_memo = selected_element.try(:memo) ||
                      selected_element.try(:description) ||
                      selected_element.try(:body) ||
                      selected_element.try(:content) %>

    <% selected_element_image_url =
         if selected_element.respond_to?(:image) && selected_element.image.present?
           selected_element.image.url
         elsif selected_element.respond_to?(:story_element_image) && selected_element.story_element_image&.image.present?
           selected_element.story_element_image.image.url
         end %>

    <%# 押すまでは名前だけ、押すとその要素の画像・メモが開く（トグル表示） %>
    <details style="margin-bottom: 12px;">
      <summary style="cursor: pointer; background: #2a2a2a; border: 1px solid #555555; border-radius: 8px; padding: 10px 12px; font-weight: bold; color: #f5f5f5;">
        <%= element_label_for.call(selected_element) %>
      </summary>

      <%= link_to story_story_element_path(@story, selected_element, breadcrumb_params),
                  style: "display: block; text-decoration: none; color: inherit;" do %>
        <div style="margin: 12px 0 0 0; padding: 16px; border: 2px solid #555555; border-left: 6px solid #888888; border-radius: 16px; background: #1e1e1e; color: #f5f5f5;">
          <div style="margin-bottom: 12px;">
            <% if selected_element_image_url.present? %>
              <%= image_tag selected_element_image_url,
                            style: "display: block; width: 240px; height: 140px; object-fit: cover; border: 2px solid #555555; border-radius: 12px;" %>
            <% else %>
              <div style="display: flex; align-items: center; justify-content: center; width: 240px; height: 140px; border: 2px solid #555555; border-radius: 12px; background: #2a2a2a; color: #f5f5f5;">
                画像なし
              </div>
            <% end %>
          </div>

          <% if element_memo.present? %>
            <div style="color: #f5f5f5;">
              <%= simple_format(element_memo.to_s) %>
            </div>
          <% else %>
            <div style="color: #dddddd;">メモなし</div>
          <% end %>
        </div>
      <% end %>
    </details>
  <% end %>

  <% total_event_detail_memos =
       @events.sum do |event|
         event.story_event_ideas
              .joins(:story_elements)
              .where(story_elements: { id: @selected_elements.map(&:id) })
              .group(:id)
              .having("COUNT(DISTINCT story_elements.id) = ?", @selected_elements.size)
              .count
              .size
       end %>

  <div style="margin: 24px 0 12px 0;">
    <div style="font-size: 22px; font-weight: bold; margin-bottom: 8px; color: #c4b5fd;">検索結果</div>
    <p style="margin: 0 0 6px 0;">該当イベント数：<strong><%= @events.size %>件</strong></p>
    <p style="margin: 0;">該当詳細メモ数：<strong><%= total_event_detail_memos %>件</strong></p>
  </div>

  <% if @events.blank? %>
    <% if @selected_elements.size > 1 %>
      <p>選択した要素が全員そろって登場するイベントは見つかりませんでした。</p>
    <% else %>
      <p>この要素はどのイベントにも登場していません。</p>
    <% end %>
  <% else %>
    <div style="margin: 16px 0;">
      <% @events.each do |event| %>
        <% event_detail_memos = event.story_event_ideas
                                   .joins(:story_elements)
                                   .where(story_elements: { id: @selected_elements.map(&:id) })
                                   .group(:id)
                                   .having("COUNT(DISTINCT story_elements.id) = ?", @selected_elements.size)
                                   .order(:position) %>

        <% event_image_url =
             if event.respond_to?(:image) && event.image.present?
               event.image.url
             elsif event.respond_to?(:story_event_image) && event.story_event_image&.image.present?
               event.story_event_image.image.url
             end %>

        <div style="margin: 0 0 20px 0; padding: 16px; border: 2px solid #555555; border-radius: 16px; background: #1e1e1e; color: #f5f5f5;">
          <div style="font-size: 24px; font-weight: bold; margin-bottom: 12px; color: #c4b5fd;">
            <%= event.title %>
          </div>

          <div style="margin-bottom: 16px;">
            <% if event_image_url.present? %>
              <%= image_tag event_image_url,
                            style: "display: block; width: 240px; height: 140px; object-fit: cover; border: 2px solid #555555; border-radius: 12px;" %>
            <% else %>
              <div style="display: flex; align-items: center; justify-content: center; width: 240px; height: 140px; border: 2px solid #555555; border-radius: 12px; background: #2a2a2a; color: #f5f5f5;">
                画像なし
              </div>
            <% end %>
          </div>

          <div style="font-weight: bold; margin-bottom: 6px; color: #c4b5fd;">イベント本文</div>
          <% if event.body.present? %>
            <div style="margin-bottom: 16px; color: #f5f5f5;">
              <%= simple_format(truncate(event.body.to_s, length: 160)) %>
            </div>
          <% else %>
            <div style="margin-bottom: 16px; color: #dddddd;">本文なし</div>
          <% end %>

          <div style="margin: 30px 0 30px 0;">
            <%= link_to "イベント詳細へ",
                        story_story_event_path(@story, event),
                        style: "color: #9ecbff; font-weight: bold; text-decoration: underline;" %>
          </div>

          <div style="font-weight: bold; margin-bottom: 8px; color: #c4b5fd;">詳細メモ</div>
          <% if event_detail_memos.any? %>
            <% event_detail_memos.each do |event_detail_memo| %>
              <% memo = event_detail_memo.try(:memo) ||
                        event_detail_memo.try(:body) ||
                        event_detail_memo.try(:content) ||
                        event_detail_memo.try(:description) %>

              <% event_detail_memo_image_url =
                   if event_detail_memo.respond_to?(:image) && event_detail_memo.image.present?
                     event_detail_memo.image.url
                   elsif event_detail_memo.respond_to?(:idea_image) && event_detail_memo.idea_image&.image.present?
                     event_detail_memo.idea_image.image.url
                   end %>

              <%= link_to story_story_event_story_event_idea_path(@story, event, event_detail_memo),
                          style: "display: block; text-decoration: none; color: inherit;" do %>
                <div style="margin-bottom: 12px; padding: 12px; border: 2px solid #555555; border-radius: 12px; background: #2a2a2a; color: #f5f5f5;">
                  <% if event_detail_memo.title.present? %>
                    <div style="font-weight: bold; margin-bottom: 6px; color: #f5f5f5;"><%= event_detail_memo.title %></div>
                  <% end %>

                  <div style="margin-bottom: 12px;">
                    <% if event_detail_memo_image_url.present? %>
                      <%= image_tag event_detail_memo_image_url,
                                    style: "display: block; width: 240px; height: 140px; object-fit: cover; border: 2px solid #555555; border-radius: 12px;" %>
                    <% else %>
                      <div style="display: flex; align-items: center; justify-content: center; width: 240px; height: 140px; border: 2px solid #555555; border-radius: 12px; background: #1e1e1e; color: #f5f5f5;">
                        画像なし
                      </div>
                    <% end %>
                  </div>

                  <% if memo.present? %>
                    <div style="color: #f5f5f5;">
                      <%= simple_format(truncate(memo.to_s, length: 160)) %>
                    </div>
                  <% else %>
                    <div style="color: #dddddd;">本文なし</div>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          <% else %>
            <div style="margin-bottom: 16px; color: #dddddd;">該当する詳細メモはありません。</div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% else %>
  <p>要素を選ぶと、登場イベントの時系列が表示されます。</p>
<% end %>
