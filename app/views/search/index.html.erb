<!-- app/views/search/index.html.erb -->
<style>
  /*
    このページの紹介カード（紫）・結果カード（青）に使う共通の箱。
    ストーリー詳細ページなどのカードと同じ考え方で、背景色と枠線の
    ついた「箱」で内容を囲んで区切りをはっきりさせている。
  */
  .story-section-card {
    /*
      枠・角ブラケット・発光に使う色。ここでは青をデフォルトにしているが、
      個別のカード側で style="--card-accent-rgb: 168, 85, 247;" のように
      上書きすると、そのカードだけ色を変えられる（上の紫カードの例）。
    */
    --card-accent-rgb: 56, 189, 248;

    background-color: rgba(0, 0, 0, 0.55);
    border: 2px solid rgba(var(--card-accent-rgb), 0.5);
    border-radius: 6px;
    padding: 20px;
    margin: 20px 0;

    /*
      対象をロックオンしているような「四隅の角ブラケット」。
      background-image に、線1本ぶんの単色グラデーションを8枚重ね、
      それぞれを background-position で四隅（横線・縦線のペア）に配置している。
      内側に余白を空けず、カードの実際の角ぴったりに合わせている。
    */
    background-image:
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1));
    background-repeat: no-repeat;
    background-size:
      32px 3px, 3px 32px,
      32px 3px, 3px 32px,
      32px 3px, 3px 32px,
      32px 3px, 3px 32px;
    background-position:
      left 0 top 0, left 0 top 0,
      right 0 top 0, right 0 top 0,
      left 0 bottom 0, left 0 bottom 0,
      right 0 bottom 0, right 0 bottom 0;
    background-origin: border-box;

    /*
      ロックオン中のようなうっすら発光する雰囲気を、カード全体に足す。
      1つ目（inset無し）が外側への光、2つ目（inset）が内側への光。
    */
    box-shadow:
      0 0 24px rgba(var(--card-accent-rgb), 0.55),
      inset 0 0 80px rgba(var(--card-accent-rgb), 0.65);
  }
</style>

<% q = @query.to_s %>
<% scope = (@scope.presence || "all").to_s %>
<% breadcrumb_params = (@search_breadcrumb_params || {}).merge(return_to: request.fullpath) %>

<div class="story-section-card" style="--card-accent-rgb: 192, 132, 252;">
  <h1 style="color: #c4b5fd; margin-top: 0;">検索結果</h1>

  <h2 style="color: #c4b5fd;">検索条件</h2>
  <ul>
  <li>検索ワード：<%= q.presence || "（未入力）" %></li>
  <li>
    範囲：
    <%= ({ "all" => "すべて", "home" => "ホーム未所属", "story" => "ストーリー内", "event" => "イベント内", "story_event_idea" => "詳細メモ内", "element" => "要素内" }[scope] || "すべて") %>
  </li>
  <li>
    検索対象：
    <% if @within_story && @story.present? %>
      この作品内（<%= @story.title %>）のみ
    <% else %>
      全体アイデア
    <% end %>
  </li>

  <li>
    要素：
    <% kind_labels = { "character" => "キャラ", "item" => "アイテム", "setting" => "設定", "place" => "場所", "organization" => "団体" } %>
    <% if @selected_story_elements.present? %>
      <% @selected_story_elements.each do |element| %>
        [<%= kind_labels[element.kind.to_s] || element.kind %>]<%= element.marker %>　<%= element.name %><br>
      <% end %>
    <% else %>
      （なし）
    <% end %>
  </li>
</ul>

<% if @within_story && @story.present? && @story.story_elements.any? %>
  <div style="margin: 16px 0 24px 0;">
    <div style="font-size: 20px; font-weight: bold; margin-bottom: 8px; color: #c4b5fd;">要素で絞り込む</div>
    <p style="margin: 0 0 8px 0; font-size: 15px;">複数選ぶと、選んだ要素が全部そろって紐づいているアイデアだけに絞り込まれます。</p>

    <%= form_with url: search_path, method: :get, local: true,
                  data: { controller: "element-selector", action: "change->element-selector#refresh" } do %>
      <%= hidden_field_tag :q, params[:q] if params[:q].present? %>
      <%= hidden_field_tag :scope, params[:scope] if params[:scope].present? %>
      <%= hidden_field_tag :within_story, "1" %>
      <%= hidden_field_tag :story_id, @story.id %>
      <%= hidden_field_tag :from, params[:from] if params[:from].present? %>
      <%= hidden_field_tag :story_event_id, params[:story_event_id] if params[:story_event_id].present? %>
      <%= hidden_field_tag :story_event_idea_id, params[:story_event_idea_id] if params[:story_event_idea_id].present? %>
      <%= hidden_field_tag :page_type, params[:page_type] if params[:page_type].present? %>
      <%= hidden_field_tag :page_id, params[:page_id] if params[:page_id].present? %>
      <%= hidden_field_tag :return_to, params[:return_to] if params[:return_to].present? %>

      <%# チェックを全部外した状態でも送信できるよう、キー自体を必ず残しておく隠しフィールド %>
      <%= hidden_field_tag "search_story_element_ids[]", "" %>

      <% grouped_elements = @story.story_elements.group_by(&:kind) %>

      <%# チェックした瞬間、押す前でもここに選んだ要素がタグで表示される %>
      <div style="margin-bottom: 12px; border: 1px solid #555555; border-radius: 8px; padding: 16px; background: #1e1e1e; color: #ffffff; max-width: 420px;">
        <div style="font-size: 20px; font-weight: bold; margin-bottom: 4px; color: #ddd6fe;">
          選択中の要素
        </div>
        <p style="margin: 0 0 12px 0; font-size: 14px; color: #cccccc;">
          ×を押すと、その要素の選択を解除できます。
        </p>

        <p data-element-selector-target="emptyMessage" style="margin: 0; color: #cccccc;">
          まだ選択されていません
        </p>

        <div data-element-selector-target="summary" data-kind="character" hidden style="margin-bottom: 16px; color: #ffffff;"></div>
        <div data-element-selector-target="summary" data-kind="item" hidden style="margin-bottom: 16px; color: #ffffff;"></div>
        <div data-element-selector-target="summary" data-kind="setting" hidden style="margin-bottom: 16px; color: #ffffff;"></div>
        <div data-element-selector-target="summary" data-kind="place" hidden style="margin-bottom: 16px; color: #ffffff;"></div>
        <div data-element-selector-target="summary" data-kind="organization" hidden style="color: #ffffff;"></div>
      </div>

      <div style="border: 1px solid #555555; border-radius: 8px; padding: 16px; background: #1e1e1e; color: #ffffff; max-width: 420px;">
        <%# 要素数が増えても縦に長くなりすぎないよう、分類ごとに開閉できるようにする %>
        <% [
          ["character", "キャラクター"],
          ["item", "アイテム"],
          ["setting", "設定"],
          ["place", "場所"],
          ["organization", "団体・グループ"]
        ].each do |kind, kind_group_label| %>
          <% elements_of_kind = grouped_elements[kind] || [] %>
          <% next if elements_of_kind.blank? %>

          <% any_selected_in_kind = elements_of_kind.any? { |el| @selected_story_element_ids.include?(el.id) } %>

          <details style="margin-bottom: 12px;" <%= "open" if any_selected_in_kind %>>
            <summary style="cursor: pointer; background: #2a2a2a; border: 1px solid #555555; border-radius: 6px; padding: 10px 12px; font-weight: bold; color: #f5f5f5;">
              <%= kind_group_label %>（<%= elements_of_kind.size %>）
            </summary>

            <div style="padding: 12px 8px 0 8px;">
              <% elements_of_kind.each do |element| %>
                <div style="margin-bottom: 8px; display: flex; align-items: center; gap: 8px; color: #ffffff;">
                  <% checkbox_id = "search_story_element_ids_#{element.id}" %>

                  <%= check_box_tag "search_story_element_ids[]",
                        element.id,
                        @selected_story_element_ids.include?(element.id),
                        id: checkbox_id,
                        data: {
                          "element-selector-target": "checkbox",
                          kind: element.kind,
                          label: truncate("#{element.marker}　#{element.name}", length: 40)
                        } %>

                  <label for="<%= checkbox_id %>" style="cursor: pointer; margin-bottom: 0; color: #ffffff;">
                    <%= truncate("#{element.marker}　#{element.name}", length: 40) %>
                  </label>
                </div>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>

      <div style="margin-top: 8px;">
        <%= submit_tag "絞り込む",
              style: "background: #2563eb; color: #ffffff; border: none; border-radius: 8px; padding: 10px 20px; font-weight: bold; cursor: pointer;" %>
      </div>
    <% end %>
  </div>
<% end %>
</div>

<% results = (@results || {}).with_indifferent_access %>

<%# 要素を複数指定した検索結果はGROUP BYされているため、.countだと合計件数ではなく
    グループごとの内訳(Hash)が返ってきてしまう。.to_a.sizeなら常に件数(Integer)になる %>
<% record_count = ->(rel) { rel.nil? ? 0 : rel.to_a.size } %>
<% pair_total = ->(pair) { record_count.call(pair[:created_here]) + record_count.call(pair[:moved]) } %>
<% home_total = ->(pair) { record_count.call(pair[:created_here]) } %>

<% snippet_for = lambda do |text, keyword|
     s = text.to_s
     k = keyword.to_s
     if k.present? && (i = s.index(k))
       left  = [i - 40, 0].max
       right = [i + k.length + 40, s.length].min
       "…#{s[left...right]}…"
     else
       s.length > 160 ? "#{s[0, 160]}…" : s
     end
   end %>

<% idea_image_url_for = lambda do |idea|
     if idea.respond_to?(:image) && idea.image.present?
       idea.image.url
     elsif idea.respond_to?(:idea_image) && idea.idea_image&.image.present?
       idea.idea_image.image.url
     end
   end %>

<% render_idea_card = lambda do |idea|
     idea_image_url = idea_image_url_for.call(idea)
%>
  <%= link_to idea_path(idea, breadcrumb_params),
              style: "display: block; text-decoration: none; color: inherit;" do %>
    <div style="margin: 0 0 12px 0; padding: 16px; border: 2px solid #555555; border-radius: 16px; background: #1e1e1e; color: #f5f5f5;">
      <%# 見本アイデアだけ、タイトルの色を変えて一般のアイデアと区別する %>
      <% if idea.title.present? %>
        <div style="font-weight: bold; margin-bottom: 6px; color: <%= idea.sample? ? "#facc15" : "#7dd3fc" %>;"><%= idea.title %></div>
      <% end %>

      <div style="margin-bottom: 12px;">
        <% if idea_image_url.present? %>
          <%= image_tag idea_image_url,
                        style: "display: block; width: 240px; height: 140px; object-fit: cover; border: 2px solid #555555; border-radius: 12px;" %>
        <% else %>
          <div style="display: flex; align-items: center; justify-content: center; width: 240px; height: 140px; border: 2px solid #555555; border-radius: 12px; background: #2a2a2a; color: #f5f5f5;">
            画像なし
          </div>
        <% end %>
      </div>

      <% if idea.memo.present? %>
        <div style="display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; overflow: hidden; white-space: normal; line-height: 1.6; max-height: 4.8em; color: #f5f5f5;">
          <%= simple_format(snippet_for.call(idea.memo, q)) %>
        </div>
      <% else %>
        <div style="color: #dddddd;">本文なし</div>
      <% end %>
    </div>
  <% end %>
<% end %>

<div class="story-section-card">
<% if q.blank? && @selected_story_element_ids.blank? %>
  <p style="margin: 0;">検索ワードを入力して検索してください。</p>
<% else %>
  <h2 style="color: #7dd3fc; margin-top: 0;">件数</h2>

  <% if scope == "all" %>
    <ul>
      <li>ホーム未所属: <%= home_total.call(results[:home] || {}) %> 件</li>
      <li>ストーリー内: <%= pair_total.call(results[:story] || {}) %> 件</li>
      <li>イベント内: <%= pair_total.call(results[:event] || {}) %> 件</li>
      <li>詳細メモ内: <%= pair_total.call(results[:story_event_idea] || {}) %> 件</li>
      <li>要素内: <%= pair_total.call(results[:element] || {}) %> 件</li>
    </ul>
  <% else %>
    <% label =
         { "home" => "ホーム未所属", "story" => "ストーリー内", "event" => "イベント内", "story_event_idea" => "詳細メモ内", "element" => "要素内" }[scope] || "すべて" %>

    <% count =
         if scope == "home"
           home_total.call(results[:home] || {})
         else
           pair_total.call(results[scope.to_sym] || {})
         end %>

    <p><strong><%= label %></strong>: <%= count %> 件</p>
  <% end %>

  <hr style="border: none; border-top: 1px solid #444444; margin: 20px 0;">

  <% render_category = lambda do |title, key, is_home: false|
       pair = results[key] || {}
       created_rel = pair[:created_here] || Idea.none
       moved_rel   = pair[:moved] || Idea.none
  %>
    <section style="margin-bottom: 24px;">
      <h1 style="color: #7dd3fc;"><%= title %></h1>

      <% if is_home %>
        <% if created_rel.to_a.empty? %>
          <p>該当なし</p>
        <% else %>
          <div style="margin: 16px 0;">
            <% created_rel.limit(50).each do |idea| %>
              <% render_idea_card.call(idea) %>
            <% end %>
          </div>
        <% end %>
      <% else %>
        <h2 style="color: #7dd3fc;">新規作成したアイデア</h2>
        <% if created_rel.to_a.empty? %>
          <p>該当なし</p>
        <% else %>
          <div style="margin: 16px 0;">
            <% created_rel.limit(50).each do |idea| %>
              <% render_idea_card.call(idea) %>
            <% end %>
          </div>
        <% end %>

        <h2 style="color: #7dd3fc;">移動してきたアイデア</h2>
        <% if moved_rel.to_a.empty? %>
          <p>該当なし</p>
        <% else %>
          <div style="margin: 16px 0;">
            <% moved_rel.limit(50).each do |idea| %>
              <% render_idea_card.call(idea) %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </section>
  <% end %>

  <% if scope == "all" %>
    <% render_category.call("ホーム未所属", :home, is_home: true) %>
    <% render_category.call("ストーリー内", :story) %>
    <% render_category.call("イベント内", :event) %>
    <% render_category.call("詳細メモ内", :story_event_idea) %>
    <% render_category.call("要素内", :element) %>
  <% elsif scope == "home" %>
    <% render_category.call("ホーム未所属", :home, is_home: true) %>
  <% elsif scope == "story" %>
    <% render_category.call("ストーリー内", :story) %>
  <% elsif scope == "event" %>
    <% render_category.call("イベント内", :event) %>
  <% elsif scope == "story_event_idea" %>
    <% render_category.call("詳細メモ内", :story_event_idea) %>
  <% elsif scope == "element" %>
    <% render_category.call("要素内", :element) %>
  <% end %>
<% end %>
</div>
