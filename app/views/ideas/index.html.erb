<style>
  /*
    このページ冒頭の紹介カード。ストーリー詳細ページなどの紹介カードと
    同じ考え方で、見出し＋説明文を背景色と枠線のついた「箱」で囲んでいる。
  */
  .story-section-card {
    /*
      枠・角ブラケット・発光に使う色。ここでは青をデフォルトにしているが、
      個別のカード側で style="--card-accent-rgb: 168, 85, 247;" のように
      上書きすると、そのカードだけ色を変えられる（下の紫カードの例）。
    */
    --card-accent-rgb: 56, 189, 248;

    background-color: rgba(0, 0, 0, 0.55);
    border: 2px solid rgba(var(--card-accent-rgb), 0.5);
    border-radius: 6px;
    padding: 20px;
    margin: 20px 0;

    /*
      対象をロックオンしているような「四隅の角ブラケット」。
      background-image に、線1本ぶんの単色グラデーションを8枚重ね、
      それぞれを background-position で四隅（横線・縦線のペア）に配置している。
      内側に余白を空けず、カードの実際の角ぴったりに合わせている。
    */
    background-image:
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1)),
      linear-gradient(rgba(var(--card-accent-rgb), 1), rgba(var(--card-accent-rgb), 1));
    background-repeat: no-repeat;
    background-size:
      32px 3px, 3px 32px,
      32px 3px, 3px 32px,
      32px 3px, 3px 32px,
      32px 3px, 3px 32px;
    background-position:
      left 0 top 0, left 0 top 0,
      right 0 top 0, right 0 top 0,
      left 0 bottom 0, left 0 bottom 0,
      right 0 bottom 0, right 0 bottom 0;
    background-origin: border-box;

    /*
      ロックオン中のようなうっすら発光する雰囲気を、カード全体に足す。
      1つ目（inset無し）が外側への光、2つ目（inset）が内側への光。
    */
    box-shadow:
      0 0 24px rgba(var(--card-accent-rgb), 0.55),
      inset 0 0 80px rgba(var(--card-accent-rgb), 0.65);
  }
</style>

<div class="story-section-card" style="--card-accent-rgb: 192, 132, 252;">
  <h1 style="color: #c4b5fd; margin-top: 0;">アイデア一覧（ホーム）</h1>

  <p style="margin: 8px 0 8px 0; font-size: 17px;">
    思いついたアイデアを保存し、あとから見返したり整理したりできます。
  </p>

  <p style="margin: 0 0 0 0; font-size: 17px;">
    まずはアイデア作成またはAI作成から始め、作品化したくなったら
    <%= link_to "ストーリー制作する",
              stories_path,
              style: "color: #fdba74; font-weight: bold; text-decoration: underline; border: 1px solid #60a5fa; border-radius: 6px; padding: 1px 4px; display: inline-block;" %>
    から作成できます。
  </p>
</div>

<div class="story-section-card" data-controller="scroll-into-view">
  <h2 data-scroll-into-view-target="anchor" style="margin: 0 0 16px 0; font-size: 24px; color: #7dd3fc;">作成したアイデア一覧</h2>

  <p style="margin: 0 0 16px 0;">
    <%= link_to "アイデアを作成する", new_idea_path, style: "display: inline-block; padding: 10px 16px; border: 2px solid #5f8f6b; border-radius: 12px; background: #5f8f6b; color: #ffffff; text-decoration: none; font-weight: bold; margin-right: 12px;" %>
    <%= link_to "AIで作成する", random_words_pick_path, style: "display: inline-block; padding: 10px 16px; border: 2px solid #5f6ee6; border-radius: 12px; background: #5f6ee6; color: #ffffff; text-decoration: none; font-weight: bold;" %>
  </p>

  <br>

  <p style="margin: 0 0 20px 0; font-size: 15px;">
    作品化したくなったら、
    <%= link_to "ストーリー制作する", stories_path, style: "color: #fdba74; font-weight: bold; text-decoration: underline;" %>
    から作成しましょう。
  </p>

  <br>

  <%= turbo_frame_tag "ideas_list",
                       data: {
                         action: "turbo:frame-load->scroll-into-view#scrollToTop"
                       } do %>
  <% if @ideas.any? %>
    <% @ideas.each do |idea| %>
      <%# data-turbo-frame="_top": この欄(Turbo Frame)の外に出て、画面全体を
          アイデア詳細ページへ遷移させる(付けないと「Content missing」になる) %>
      <%= link_to idea_path(idea), style: "display: block; text-decoration: none; color: inherit;", data: { turbo_frame: "_top" } do %>
        <div style="margin-bottom: 20px; padding: 16px; border: 2px solid #555555; border-radius: 16px; background: #1e1e1e;">
          <%# 見本アイデアだけ、タイトルの色を変えて一般のアイデアと区別する %>
          <h2 style="color: <%= idea.sample? ? "#facc15" : "#7dd3fc" %>; text-decoration: none;"><%= idea.title %></h2>

          <% if idea.idea_image&.image? %>
            <div style="margin: 8px 0;">
              <%= image_tag idea.idea_image.image.url, style: "width: 240px; height: 140px; object-fit: cover; display: block; border-radius: 12px;" %>
            </div>
          <% else %>
            <div style="width: 240px; height: 140px; margin: 8px 0; border: 2px solid #555555; border-radius: 12px; display: flex; align-items: center; justify-content: center; background: #2a2a2a; color: #f5f5f5;">
              画像なし
            </div>
          <% end %>

          <% display_memo =
               if idea.memo.to_s.start_with?("元ワード:")
                 idea.memo.to_s.lines[1..].join.lstrip
               else
                 idea.memo
               end %>

          <p style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; color: #f5f5f5; text-decoration: none;">
            <%= truncate(display_memo, length: 78) %>
          </p>

          <p style="margin: 8px 0 0 0; font-size: 14px; color: #dddddd; text-decoration: none;">
            作成日: <%= l idea.created_at, format: :short %>
            <span style="display: inline-block; margin-left: 24px;">
              更新日（文字編集のみ）: <%= l idea.updated_at, format: :short %>
            </span>
          </p>
        </div>
      <% end %>
    <% end %>
    <%= paginate @ideas %>
  <% else %>
    <p>まだアイデアがありません</p>
  <% end %>
  <% end %>
</div>
